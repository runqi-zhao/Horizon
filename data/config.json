  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 20,
    "profile_order": ["tech-news", "tech-blog", "finance-news", "deals"],
    "category_groups": {
      "ai": {
        "name": "AI / 大模型",
        "limit": 7,
        "categories": ["ai-news", "ai-tools", "machine-learning", "llm-inference", "ai-hardware"]
      },
      "engineering": {
        "name": "软件工程 / 基础设施",
        "limit": 7,
        "categories": ["software-engineering", "linux", "performance", "consumer-tech", "tech-news", "tech-community", "open-source"]
      },
      "hardware": {
        "name": "硬件 / 芯片 / 机器人",
        "limit": 4,
        "categories": ["semiconductors", "hardware", "robotics"]
      },
      "business": {
        "name": "创投 / 商业",
        "limit": 4,
        "categories": ["startups", "venture", "business-analysis"]
      },
      "deals": {
        "name": "好价精选",
        "limit": 3,
        "categories": ["deals"]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": true,
    "url_env": "TELEGRAM_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": ["zh"],
    "request_body": {
      "chat_id": "${TELEGRAM_CHAT_ID}",
      "text": "#{message_title}\n\n#{summary?limit=3500&split=\n}",
      "disable_web_page_preview": true
    },
    "headers": ""
  },
  "wechat": {
    "enabled": false,
    "languages": null,
    "chunk_size": 4000
  }
}
